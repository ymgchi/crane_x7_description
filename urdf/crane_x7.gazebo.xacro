<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="material_gazebo_black">
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1</ambient>
        <diffuse>0.0 0.0 0.0 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="material_gazebo_white">
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1</ambient>
        <diffuse>0.95 0.95 0.95 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="material_gazebo_red">
    <visual>
      <material>
        <ambient>1.0 0.3 0.3 1</ambient>
        <diffuse>1.0 0.0 0.0 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="gazebo_robot_settings"
    params="name_link_mounting_plate
            name_link_base
            name_link_1
            name_link_2
            name_link_3
            name_link_4
            name_link_5
            name_link_6
            name_link_cover_2_l
            name_link_cover_2_r
            name_link_cover_4_l
            name_link_cover_4_r
            name_link_logo_symbol_l
            name_link_logo_symbol_r
            name_link_logo_text_l
            name_link_logo_text_r
            name_link_gripper_base
            name_link_gripper_finger_a
            name_link_gripper_finger_b
            config_package
            config_file_path
            ">

    <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(find ${config_package})/${config_file_path}</parameters>
      </plugin>
    </gazebo>

    <gazebo reference="${name_link_mounting_plate}">
      <xacro:material_gazebo_black/>
    </gazebo>

    <gazebo reference="${name_link_base}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_1}">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="${name_link_2}">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="${name_link_3}">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="${name_link_4}">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="${name_link_5}">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="${name_link_6}">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="${name_link_cover_2_l}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_cover_2_r}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_cover_4_l}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_cover_4_r}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_logo_symbol_l}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_logo_symbol_r}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_logo_text_l}">
      <xacro:material_gazebo_black/>
    </gazebo>

    <gazebo reference="${name_link_logo_text_r}">
      <xacro:material_gazebo_black/>
    </gazebo>

    <gazebo reference="${name_link_gripper_base}">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_gripper_finger_a}">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="${name_link_gripper_finger_b}">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

  </xacro:macro>

  <!-- Gazebo RGBD Camera Sensor -->
  <xacro:macro name="gazebo_camera_sensor" params="parent_link">

    <!-- Camera link -->
    <link name="camera_link">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
        <material name="camera_material">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <!-- Collision disabled to avoid self-collision with gripper in MoveIt -->
      <!--
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.09 0.025"/>
        </geometry>
      </collision>
      -->
    </link>

    <!-- Camera joint -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="camera_link"/>
      <origin xyz="0.0 0.032 0.0191" rpy="-1.5708 -1.5708 0"/>
    </joint>

    <!-- Camera optical frame -->
    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- Gazebo Fortress RGB Camera -->
    <gazebo reference="camera_link">
      <sensor name="camera_color" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera/color</topic>
        <enable_metrics>false</enable_metrics>
        <camera name="camera_color">
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>277.0</fx>
              <fy>277.0</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>
    </gazebo>

    <!-- Gazebo Fortress Depth Camera -->
    <gazebo reference="camera_link">
      <sensor name="camera_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera/depth</topic>
        <enable_metrics>false</enable_metrics>
        <camera name="camera_depth">
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>277.0</fx>
              <fy>277.0</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>